---
// Every post plotted by publication date × intensity. Hover for the title, click to read.
// Drawn twice (wide + narrow) so the text stays legible on phones.
import { fmtDate, type Post } from '../lib/posts';
interface Props { posts: Post[] }
const { posts } = Astro.props;
const times = posts.map((p) => p.data.date.getTime());
const t0 = Math.min(...times), t1 = Math.max(...times);
const span = t1 - t0 || 1;
const layouts = [
  { cls: 'tm-wide', W: 1000, H: 200 },
  { cls: 'tm-narrow', W: 360, H: 200 },
].map(({ cls, W, H }) => {
  const m = { l: 30, r: 14, t: 14, b: 28 };
  return {
    cls, W, H, m,
    x: (t: number) => (posts.length === 1 ? W / 2 : m.l + 10 + ((t - t0) / span) * (W - m.l - m.r - 20)),
    y: (s: number) => m.t + (1 - s / 5) * (H - m.t - m.b),
  };
});
---
{posts.length > 0 && (
  <figure class="viz thought-map">
    <figcaption class="viz-title">Every post, by date and intensity</figcaption>
    {layouts.map(({ cls, W, H, m, x, y }) => (
      <svg viewBox={`0 0 ${W} ${H}`} class={`viz-svg ${cls}`} style="width:100%;height:auto" role="img" aria-label="Posts plotted by date and intensity">
        {[0, 1, 2, 3, 4, 5].map((s) => (
          <g class="axis">
            <line x1={m.l} x2={W - m.r} y1={y(s)} y2={y(s)} class={s === 0 ? 'baseline' : 'grid'} />
            <text x={m.l - 10} y={y(s) + 4} text-anchor="end">{s}</text>
          </g>
        ))}
        {posts.map((p) => (
          <a href={`/posts/${p.id}/`} aria-label={p.data.title}>
            <g class="tm-dot">
              <circle cx={x(p.data.date.getTime())} cy={y(p.data.spice)} r="14" fill="transparent" />
              <circle cx={x(p.data.date.getTime())} cy={y(p.data.spice)} r="6.5" fill="var(--s1)" stroke="var(--paper)" stroke-width="2" />
              <title>{p.data.title} · {fmtDate(p.data.date)}</title>
            </g>
          </a>
        ))}
        <g class="axis">
          <text x={m.l} y={H - 6}>{fmtDate(new Date(t0))}</text>
          <text x={W - m.r} y={H - 6} text-anchor="end">{fmtDate(new Date(t1))}</text>
        </g>
      </svg>
    ))}
  </figure>
)}
