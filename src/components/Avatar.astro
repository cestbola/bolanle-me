---
// Your photo. Falls back to your initial until public/<photo> exists.
import { existsSync } from 'node:fs';
import { ME } from '../site';

interface Props { size?: number; framed?: boolean; round?: boolean }
const { size = 160, framed = false, round = false } = Astro.props;
const hasPhoto = !!ME.photo && existsSync(`public${ME.photo}`);
---
<span class:list={['avatar', { framed, round }]} style={`--size:${size}px`}>
  {hasPhoto ? (
    <img src={ME.photo} alt={ME.photoAlt} width={size} height={size} loading="lazy" decoding="async" />
  ) : (
    <span class="avatar-fallback" role="img" aria-label={ME.photoAlt}>{ME.name.charAt(0)}</span>
  )}
</span>
