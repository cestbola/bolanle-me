---
import '../styles/global.css';
import { SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = SITE.description } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const path = Astro.url.pathname;
const nav = [
  { href: '/posts/', label: 'Writing' },
  { href: '/chart-lab/', label: 'Chart Lab' },
  { href: '/about/', label: 'About' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2210%22 fill=%22%23ffc629%22/><text x=%2250%22 y=%2272%22 font-size=%2270%22 font-family=%22Georgia,serif%22 font-weight=%22700%22 text-anchor=%22middle%22 fill=%22%23141310%22>b</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400&display=swap" rel="stylesheet" />
    <script is:inline>
      try {
        const t = localStorage.getItem('bolanle:theme');
        if (t) document.documentElement.dataset.theme = JSON.parse(t);
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap-wide">
        <a class="logo" href="/"><span class="logo-mark" aria-hidden="true">b</span>{SITE.name}</a>
        <nav class="nav" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
          <button class="theme-switch" id="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Dark mode" title="Switch between light and dark mode">
            <svg class="ico sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="ico moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <span class="knob" aria-hidden="true"></span>
          </button>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap-wide">
        <span>© {new Date().getFullYear()} {SITE.author}</span>
        <span><a href="/about/">About</a> · <a href="/rss.xml">RSS</a></span>
      </div>
    </footer>
    <script>
      // Light/dark switch. Starts from the visitor's system setting; a click
      // overrides it and is remembered on this device.
      const btn = document.getElementById('theme-toggle')!;
      const root = document.documentElement;
      const media = matchMedia('(prefers-color-scheme: dark)');
      const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : media.matches);
      const sync = () => btn.setAttribute('aria-checked', String(isDark()));
      sync();
      media.addEventListener('change', sync);
      btn.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('bolanle:theme', JSON.stringify(next)); } catch {}
        sync();
      });
    </script>
  </body>
</html>
