---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, slugifyTag } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag: slugifyTag(tag) },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}
const { tag, posts } = Astro.props;
---
<Base title={tag}>
  <div class="wrap-wide">
    <section class="page-head">
      <span class="kicker">Topic</span>
      <h1>{tag}</h1>
      <p>{posts.length} post{posts.length === 1 ? '' : 's'}. <a href="/posts/">See all writing →</a></p>
    </section>
    <PostList posts={posts} />
  </div>
</Base>
