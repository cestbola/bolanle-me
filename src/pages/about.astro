---
import Base from '../layouts/Base.astro';
import Avatar from '../components/Avatar.astro';
import { ME } from '../site';

const escape = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
// Business names become links wherever they appear, once their website is set in site.ts
const linkVentures = (html: string) =>
  ME.ventures.reduce(
    (out, v) => (v.href ? out.split(escape(v.name)).join(`<a href="${escape(v.href)}" rel="noopener" target="_blank">${escape(v.name)}</a>`) : out),
    html,
  );
// tiny **bold** support for bio paragraphs
const md = (t: string) => linkVentures(escape(t).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>'));
---
<Base title="About" description={ME.shortBio}>
  <div class="wrap">
    <section class="about-top">
      <Avatar size={200} framed />
      <div>
        <span class="kicker">About</span>
        <h1>{ME.name}</h1>
        <p class="about-short" set:html={linkVentures(escape(ME.shortBio))} />
        {ME.links.length > 0 && (
          <div class="about-links">{ME.links.map((l) => <a class="tag" href={l.href} rel="me noopener" target="_blank">{l.label} ↗</a>)}</div>
        )}
      </div>
    </section>

    {ME.facts.length > 0 && (
      <ul class="facts">{ME.facts.map((f) => <li><b>{f.label}</b><span set:html={linkVentures(escape(f.text))} /></li>)}</ul>
    )}

    <div class="prose">
      {ME.bio.map((p) => <p set:html={md(p)} />)}
      <h2>About this site</h2>
      <p>Most posts include <strong>interactive charts</strong>. Some ask for your view: place yourself on a scale, move points on a 2×2, sketch your estimate before the data is revealed, or rearrange a ranking and compare it with mine.</p>
      <p>Your answers are stored only in your own browser. Nothing is collected or tracked.</p>
      <p>The charts are built in the <a href="/chart-lab/">Chart Lab</a>, which you're welcome to explore.</p>
    </div>
  </div>
</Base>
