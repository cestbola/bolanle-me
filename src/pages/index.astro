---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ThoughtMap from '../components/ThoughtMap.astro';
import Avatar from '../components/Avatar.astro';
import { getPosts, slugifyTag } from '../lib/posts';
import { SITE, ME } from '../site';

const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---
<Base>
  <div class="wrap-wide">
    <section class="hero">
      <div>
        <span class="kicker">{SITE.name}</span>
        <h1>Thinking out loud, <span class="hl">in charts.</span></h1>
        <p>I'm {ME.name}. {ME.shortBio}</p>
        <div class="hero-actions">
          {posts[0] && <a class="btn" href={`/posts/${posts[0].id}/`}>Read the latest</a>}
          <a class="btn ghost" href="/about/">About me</a>
        </div>
      </div>
      <a class="hero-photo" href="/about/" aria-label={`About ${ME.name}`}><Avatar size={240} framed /></a>
    </section>

    <div class="section-head">
      <h2>Latest writing</h2>
      {posts.length > 6 && <a href="/posts/">All {posts.length} posts →</a>}
    </div>
    {posts.length ? <PostList posts={posts.slice(0, 6)} /> : <p class="empty">No posts yet. Run <code>npm run new "My first post"</code>.</p>}

    <ThoughtMap posts={posts} />

    {tags.length > 0 && (
      <>
        <div class="section-head"><h2>Topics</h2></div>
        <div class="tag-cloud">{tags.map((t) => <a class="tag" href={`/tags/${slugifyTag(t)}/`}>{t}</a>)}</div>
      </>
    )}
  </div>
</Base>
